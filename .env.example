# Environment mode: dev, test, prod
APP_ENV=dev

# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/futuris

# Persistence & storage
OBJECT_STORE_PATH=./data/storage

# Large Language Model provider (anthropic | openai | none)
LLM_PROVIDER=none
LLM_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & API Key enablement
API_KEYS_ENABLED=false
