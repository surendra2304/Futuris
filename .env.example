# ============================================================================== #
#                         FUTURIS PLATFORM CONFIGURATION                         #
# ============================================================================== #
# Copy to .env and fill in REAL values. Never commit .env.
# Every credential below must be a high-entropy secret (>= 32 chars) that you
# generate yourself -- the values in an old copy of this file were guessable
# placeholders, and a deployment that kept them would have been open.

# Environment mode: dev, test, prod (production refuses to boot on placeholder
# or missing credentials -- see futuris/upgrade/safe_config.py)
APP_ENV=dev

# Database configuration (SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/futuris.db

# Persistence & snapshot storage
OBJECT_STORE_PATH=./data/storage

# Large Language Model provider (anthropic | openai | none)
LLM_PROVIDER=none
LLM_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & API Key enablement.
# Keep API_KEYS_ENABLED=true everywhere except a throwaway local sandbox:
# with it false, every protected route resolves to a full-admin dev principal.
API_KEYS_ENABLED=true
# Master key: generate with `python -m futuris.cli create-admin-key` or
# `python -c "import secrets; print('futuris_' + secrets.token_hex(24))"`
FUTURIS_API_KEY=
# Shared secret for the FRIDAY delegation surface (/v1/friday/*)
FUTURIS_FRIDAY_API_KEY=

# ============================================================================== #
#                   FRIDAY UNIVERSE MASTER ECOSYSTEM GATEWAYS                    #
# ============================================================================== #
# URLs are the fleet's public endpoints; the API keys are yours to configure in
# a secret environment (never in this file).

INFERENCE_URL=https://inference-h7bn.onrender.com
INFERENCE_API_KEY=

MEMORA_URL=https://memora-cavc.onrender.com
MEMORA_API_KEY=

STRATEX_URL=https://stratex-8wj1.onrender.com
STRATEX_API_KEY=

INTELX_URL=https://intelx-mygl.onrender.com
INTELX_API_KEY=
