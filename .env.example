# ============================================================================== #
#                         FUTURIS PLATFORM CONFIGURATION                         #
# ============================================================================== #

# Environment mode: dev, test, prod
APP_ENV=dev

# Database configuration (SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/futuris.db

# Persistence & snapshot storage
OBJECT_STORE_PATH=./data/storage

# Large Language Model provider (anthropic | openai | none)
LLM_PROVIDER=none
LLM_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & API Key enablement
FUTURIS_API_KEY=futuris_api
API_KEYS_ENABLED=false
FUTURIS_FRIDAY_API_KEY=friday_secret_key_default

# ============================================================================== #
#                   FRIDAY UNIVERSE MASTER ECOSYSTEM GATEWAYS                    #
# ============================================================================== #

INFERENCE_URL=https://inference-3i2b.onrender.com
INFERENCE_API_KEY=inference_api

MEMORA_URL=https://memora-9zr9.onrender.com
MEMORA_API_KEY=memora_api

STRATEX_URL=https://stratex-ucjz.onrender.com
STRATEX_API_KEY=stratex_api

INTELX_URL=https://intelx-3cz1.onrender.com
INTELX_API_KEY=intelx_api

