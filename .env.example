# ============================================================================== #
#                         FUTURIS PLATFORM CONFIGURATION                         #
# ============================================================================== #
# Environment mode: dev, test, prod
APP_ENV=prod
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite 3)
DATABASE_URL=sqlite+aiosqlite:///./data/futuris.db
POSTGRES_HOST=dokploy-postgres
POSTGRES_PORT=5432
POSTGRES_DB=futuris_db
POSTGRES_USER=futuris_user
# Set a private, strong password in your local environment; no credential is bundled.
POSTGRES_PASSWORD=

# Persistence & Snapshot Storage
OBJECT_STORE_PATH=./data/storage

# Autonomous Scheduling & Self-Assessment
SCHEDULER_ENABLED=true
SELF_HEALING_ENABLED=true
SELF_HEALING_INTERVAL_SECONDS=60.0
STARTUP_DEMO_SEED_ENABLED=false

# Large Language Model Provider (anthropic | openai | none)
LLM_PROVIDER=none
LLM_API_KEY=

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & API Key Governance
API_KEYS_ENABLED=true
FUTURIS_API_KEY=your_production_master_api_key_here
FUTURIS_FRIDAY_API_KEY=your_shared_friday_mesh_api_key_here
INTELX_WEBHOOK_API_KEY=your_shared_intelx_webhook_secret_here

# CORS Origin Whitelist
CORS_ORIGINS=["https://friday-universe.duckdns.org", "http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:8004", "http://localhost:8003", "http://localhost:3000"]

# ============================================================================== #
#            FRIDAY UNIVERSE - ORACLE CLOUD & CONTAINER MESH GATEWAYS            #
# ============================================================================== #
# Public Gateway: https://friday-universe.duckdns.org
# Public Route:   https://friday-universe.duckdns.org/futuris/*
# Docker Network: friday_mesh (Internal Port: 8000, Host Port: 8004)

FUTURIS_URL=http://futuris:8000

# Ecosystem Containers in friday_mesh
INFERENCE_URL=http://inference:8000
INFERENCE_API_KEY=

MEMORA_URL=http://memora:8000
MEMORA_API_KEY=

STRATEX_URL=http://stratex:8000
STRATEX_API_KEY=

INTELX_URL=http://intelx:8000
INTELX_API_KEY=

CORTEX_URL=http://cortex:8000
CORTEX_API_KEY=

FORGE_URL=http://forge:8000
FORGE_API_KEY=

SENTINEL_URL=http://sentinel:8000
SENTINEL_API_KEY=

FRIDAY_URL=http://friday:10000
FRIDAY_API_KEY=

# --- AGENT 10 VYRALX MESH ---
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=
